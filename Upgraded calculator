import tkinter as tk

# Create window
root = tk.Tk()
root.title("ERNEST CALCULATOR")
root.geometry("300x400")

# Display screen
entry = tk.Entry(root, width=20, font=("Arial", 20), borderwidth=5)
entry.grid(row=0, column=0, columnspan=4)

# Function to add numbers
def click(number):
    current = entry.get()
    entry.delete(0, tk.END)
    entry.insert(0, current + str(number))

# Function to clear
def clear():
    entry.delete(0, tk.END)

# Function to calculate
def calculate():
    result = eval(entry.get())
    entry.delete(0, tk.END)
    entry.insert(0, result)

# Buttons
buttons = [
    ('7',1,0), ('8',1,1), ('9',1,2), ('/',1,3),
    ('4',2,0), ('5',2,1), ('6',2,2), ('*',2,3),
    ('1',3,0), ('2',3,1), ('3',3,2), ('-',3,3),
    ('0',4,0), ('C',4,1), ('=',4,2), ('+',4,3),
]

for (text,row,col) in buttons:
    if text == "C":
        button = tk.Button(root, text=text, width=5, height=2, command=clear)
    elif text == "=":
        button = tk.Button(root, text=text, width=5, height=2, command=calculate)
    else:
        button = tk.Button(root, text=text, width=5, height=2, command=lambda t=text: click(t))

    button.grid(row=row, column=col)

root.mainloop()